---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const c = {
  city: "Hamilton",
  name: "Le Ballon Rouge Hamilton",
  address: "135 Bendamere Ave, Hamilton, ON L9C 1N4",
  hours: "Lundi au Vendredi 7h00 — 17h30",
  phone: "905-383-8371",
  phoneTel: "19053838371",
  email: "leballonrouge@cscmonavenir.ca",
  supervisor: "Pierangela Lattuca",
  school: "École élémentaire Mon Seigneur de Laval",
  programs: ["Bambins", "Préscolaires", "Avant et Après école"],
  inscriptionHref: "/inscription/hamilton/",
  mapsQuery: encodeURIComponent("135 Bendamere Ave, Hamilton, ON L9C 1N4"),
  googlePlaceUrl: "https://www.google.com/maps/place/Le+Ballon+Rouge/@43.2340612,-79.8920059,17z/data=!4m15!1m8!3m7!1s0x882c9b19663e1913:0x3b7c4b5e166434dc!2s135+Bendamere+Ave,+Hamilton,+ON+L9C+1N4!3b1!8m2!3d43.2341417!4d-79.892331!16s%2Fg%2F11bw41tzwd!3m5!1s0x882c9b19663e1913:0x5fe06c0c04a1ded3!8m2!3d43.2340319!4d-79.8917385!16s%2Fg%2F1vrqb8ch?entry=ttu",

  // 👇 I added a 'description' field for each staff member. 
  // You should update these with their real bios!
  staff: [
    { 
      name: "Fadwa Elkhorji", 
      photo: "/assets/images/Staff Hamilton/Fadwa.jpg", 
      description: "Chaleureuse et bienveillante, elle crée un environnement où chaque enfant se sent en sécurité, écouté et respecté. Elle accompagne les enfants avec douceur et attention." 
    },
    { 
      name: "Nicole Nyamsi", 
      photo: "/assets/images/Staff Hamilton/Nicole.jpg", 
      description: "Passionnée et responsable, elle favorise le développement global des enfants avec une approche centrée sur leurs besoins et leur rythme d'apprentissage." 
    },
    { 
      name: "Rawia Berkane", 
      photo: "/assets/images/Staff Hamilton/Rawia.jpg", 
      description: "Observatrice et intuitive, elle allie créativité et structure pour transformer le quotidien en opportunités d'apprentissage." 
    },
    { 
      name: "Alice Anzian", 
      photo: "/assets/images/Staff Hamilton/Alice.jpg", 
      description: "Curieuse et créative, passionnée par l'univers de l'enfance. Elle privilégie une approche bienveillante fondée sur la discipline positive." 
    },
    { 
      name: "Feriel Mejri", 
      photo: "/assets/images/Staff Hamilton/Feriel.jpg", 
      description: "Éducatrice attentionnée et dynamique, elle crée un environnement sécurisant et stimulant où chaque enfant peut s'épanouir et développer sa confiance." 
    },
    { 
      name: "Souad El Addali", 
      photo: "/assets/images/Staff Hamilton/Souad.jpg", 
      description: "Dynamique et organisée, elle accompagne les enfants dans leur développement et les encourage à devenir autonomes dans un environnement chaleureux." 
    },
    { 
      name: "Michelle Oko", 
      photo: "/assets/images/Staff Hamilton/Michelle.jpg", 
      description: "Éducatrice depuis 2015 avec 10 ans d'expérience au Maroc. Passionnée par l'éducation, elle crée un environnement positif et stimulant." 
    },
    { 
      name: "Jeanne Matadi", 
      photo: "/assets/images/Staff Hamilton/Jeanne.jpg", 
      description: "Passionnée par la petite enfance, elle aime explorer la nature et la musique. Empathique et bienveillante, elle offre un environnement où les enfants s'épanouissent." 
    },
    { 
      name: "Ermeline", 
      photo: "/assets/images/Staff Hamilton/Ermeline.jpg", 
      description: "Étudiante en éducation de la petite enfance au Collège Boréal, elle accompagne les enfants dans leurs découvertes avec bienveillance et patience." 
    }
  ],

  activities: [
    { src: "/assets/images/Activities - Hamilton/IMG_2645.jpg", alt: "Bricolage en groupe" },
    { src: "/assets/images/Activities - Hamilton/IMG_5090.jpg", alt: "Jeux extérieurs" },
    { src: "/assets/images/Activities - Hamilton/IMG_0644.jpg", alt: "Cercle de lecture" },
    { src: "/assets/images/Activities - Hamilton/IMG_0080.jpg", alt: "Activité musicale" },
    { src: "/assets/images/Activities - Hamilton/IMG_9332.JPG", alt: "Atelier créatif" },
    { src: "/assets/images/Activities - Hamilton/IMG_9625.JPG", alt: "Sortie éducative" },
    { src: "/assets/images/Activities - Hamilton/IMG_0245.jpg" },
    { src: "/assets/images/Activities - Hamilton/IMG_1013.jpg" },
    { src: "/assets/images/Activities - Hamilton/IMG_0784.jpg" },
  ],
};
---

<BaseLayout lang="fr" title={`${c.name} — Le Ballon Rouge`} description={`Découvrez le centre ${c.name} à ${c.city}, en Ontario.`}>

  <section class="mx-auto max-w-6xl px-4 pb-6 pt-8 md:pt-12">
    <a href="/centres/" class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-4 py-2 text-xs font-black uppercase tracking-widest text-slate-700 shadow-sm hover:bg-slate-50">
      ← Retour aux centres
    </a>

    <div class="mt-6 flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1 text-xs font-black uppercase tracking-widest text-red-700 ring-1 ring-red-100">
           {c.city}
        </div>
        <h1 class="mt-3 text-3xl font-black tracking-tight md:text-5xl">{c.name}</h1>
        <p class="mt-2 text-sm font-semibold text-slate-500">{c.address} · {c.hours}</p>
      </div>
      <a href={c.inscriptionHref} class="inline-flex items-center justify-center rounded-full bg-red-700 px-6 py-3 text-sm font-extrabold text-white shadow-lg shadow-red-700/20 hover:bg-red-800">
        Inscription — {c.city} →
      </a>
    </div>
  </section>

  <!-- Info + Map -->
  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="grid gap-5 md:grid-cols-2">

      <article class="rounded-[28px] border border-black/10 bg-white/70 p-6 shadow-xl shadow-black/5 md:p-8">
        <h3 class="text-lg font-black tracking-tight">Coordonnées</h3>
        <ul class="mt-4 space-y-3 text-sm font-semibold text-slate-700">
          <li class="flex items-start gap-3"><span class="mt-0.5 text-base"></span><span>{c.address}</span></li>
          <li class="flex items-start gap-3"><span class="mt-0.5 text-base">🕐</span><span>{c.hours}</span></li>
          <li class="flex items-start gap-3"><span class="mt-0.5 text-base">👩‍</span><span><span class="font-extrabold text-slate-900">Superviseure:</span> {c.supervisor}</span></li>
          <li class="flex items-start gap-3"><span class="mt-0.5 text-base">🏫</span><span><span class="font-extrabold text-slate-900">École:</span> {c.school}</span></li>
        </ul>

        <div class="mt-5 space-y-2">
          <a href={`tel:${c.phoneTel}`} class="flex items-center gap-3 rounded-2xl border border-black/10 bg-white/60 px-4 py-3 text-sm font-extrabold text-slate-800 hover:bg-white">📞 {c.phone}</a>
          <a href={`mailto:${c.email}`} class="flex items-center gap-3 rounded-2xl border border-black/10 bg-white/60 px-4 py-3 text-sm font-extrabold text-red-700 hover:bg-white">️ {c.email}</a>
        </div>

        <div class="mt-5">
          <p class="text-sm font-extrabold text-slate-900">Programmes offerts</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {c.programs.map((p) => (
              <span class="rounded-full border border-black/10 bg-white/70 px-3 py-1.5 text-xs font-extrabold text-slate-700">{p}</span>
            ))}
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <a href={c.inscriptionHref} class="inline-flex items-center justify-center rounded-full bg-red-700 px-5 py-2.5 text-sm font-extrabold text-white shadow-lg shadow-red-700/20 hover:bg-red-800">S'inscrire →</a>
          <a href="/programmes/" class="inline-flex items-center justify-center rounded-full border border-black/10 bg-white/80 px-5 py-2.5 text-sm font-extrabold text-slate-800 shadow-sm hover:bg-white">Nos programmes</a>
          <a href="/contact/" class="inline-flex items-center justify-center rounded-full border border-black/10 bg-white/80 px-5 py-2.5 text-sm font-extrabold text-slate-800 shadow-sm hover:bg-white">Nous contacter</a>
        </div>
      </article>

      <div class="rounded-[28px] border border-black/10 bg-white/70 p-3 shadow-xl shadow-black/5">
        <div class="aspect-[4/3] overflow-hidden rounded-2xl border border-black/10 bg-white">
          <iframe title={`Carte — Centre ${c.city}`} class="h-full w-full" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={`https://www.google.com/maps?q=${c.mapsQuery}&output=embed`} />
        </div>
        <div class="mt-3 flex flex-wrap gap-2 px-2 pb-2">
          <a href={c.googlePlaceUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-black/10 bg-white px-4 py-2 text-xs font-extrabold shadow-sm hover:bg-white/80">🗺️ Ouvrir dans Google Maps</a>
          <a href={`https://www.google.com/maps/dir/?api=1&destination=${c.mapsQuery}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-black/10 bg-white px-4 py-2 text-xs font-extrabold shadow-sm hover:bg-white/80">🧭 Obtenir l'itinéraire</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Staff -->
  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="mb-1 text-lg font-black tracking-tight">Notre équipe</h2>
    <p class="mb-6 text-sm font-medium text-slate-500">Des éducatrices et éducateurs qualifiés, dévoués au bien-être de chaque enfant. <span class="text-xs text-slate-400">(Survolez une carte pour en savoir plus!)</span></p>
    
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {c.staff.map((s) => (
        <!-- FLIP CARD CONTAINER -->
        <div class="staff-card-container">
          <div class="staff-card-inner">
            
            <!-- FRONT FACE (Photo + Name) -->
            <div class="staff-card-front rounded-[24px] border border-black/10 bg-white/70 p-4 text-center shadow-sm">
              <div class="aspect-square w-full overflow-hidden rounded-2xl bg-slate-100">
                <img src={s.photo} alt={s.name} class="h-full w-full object-cover" loading="lazy" />
              </div>
              <p class="mt-3 text-sm font-extrabold text-slate-900">{s.name}</p>
            </div>

            <!-- BACK FACE (Description) -->
            <div class="staff-card-back rounded-[24px] border border-black/10 bg-white/70 p-6 shadow-sm flex flex-col items-center justify-center text-center">
              <h3 class="text-base font-black text-red-700 mb-2">{s.name}</h3>
              <p class="text-xs font-medium text-slate-600 leading-relaxed">{s.description}</p>
            </div>

          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Activities gallery -->
  <section class="mx-auto max-w-6xl px-4 pb-12">
    <h2 class="mb-1 text-lg font-black tracking-tight">La vie au centre</h2>
    <p class="mb-6 text-sm font-medium text-slate-500">Un aperçu des activités quotidiennes de nos petits à {c.city}.</p>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {c.activities.map((img) => (
        <div class="aspect-square overflow-hidden rounded-2xl border border-black/10 bg-slate-100 shadow-sm">
          <img src={img.src} alt={img.alt} class="h-full w-full object-cover" loading="lazy" />
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<!-- CSS FOR FLIP ANIMATION -->
<style>
  .staff-card-container {
    perspective: 1500px; /* Even deeper = more realistic */
    height: 340px;
    cursor: pointer;
  }

  .staff-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 1s cubic-bezier(0.23, 1, 0.32, 1); /* Super smooth ease-out */
    transform-style: preserve-3d;
  }

  .staff-card-container:hover .staff-card-inner {
    transform: rotateY(180deg);
  }

  .staff-card-front,
  .staff-card-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 24px;
    /* Dynamic shadow that changes during flip */
    box-shadow: 
      0 2px 8px rgba(0, 0, 0, 0.04),
      0 8px 24px rgba(0, 0, 0, 0.04);
    transition: all 0.4s ease;
  }

  .staff-card-container:hover .staff-card-front,
  .staff-card-container:hover .staff-card-back {
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.12),
      0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .staff-card-back {
    transform: rotateY(180deg);
    background: linear-gradient(135deg, #fff 0%, #f5f5f5 100%);
  }

  /* Smooth fade for content inside */
  .staff-card-front > *,
  .staff-card-back > * {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* Optional: Slight content shift during flip */
  .staff-card-container:hover .staff-card-front > * {
    transform: translateZ(-20px);
    opacity: 0.7;
  }
</style>