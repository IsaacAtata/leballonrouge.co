---
// src/pages/accounts/dashboard.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

// ✅ SERVER-SIDE AUTH CHECK
const accessToken = Astro.cookies.get('sb-access-token');

if (!accessToken) {
  return Astro.redirect('/accounts/login?error=missing_token');
}

let user = null;
let displayName = 'Parent';

try {
  const { createClient } = await import('@supabase/supabase-js');
  const supabase = createClient(
    import.meta.env.SUPABASE_URL!,
    import.meta.env.SUPABASE_ANON_KEY!
  );
  
  const { data, error } = await supabase.auth.getUser(accessToken.value);
  
  if (error || !data.user) {
    Astro.cookies.delete('sb-access-token', { path: '/' });
    Astro.cookies.delete('sb-refresh-token', { path: '/' });
    return Astro.redirect('/accounts/login?error=invalid_session');
  }

  user = {
    id: data.user.id,
    email: data.user.email,
    role: 'parent',
  };

  // ✅ SMART NAME DISPLAY LOGIC
  const metaName = data.user.user_metadata?.full_name || data.user.user_metadata?.name;
  displayName = metaName 
    ? metaName.split(' ')[0]
    : (data.user.email?.split('@')[0] || 'Parent');

} catch (err) {
  console.error('[DASHBOARD AUTH ERROR]', err);
  return Astro.redirect('/accounts/login?error=server_error');
}
---

<BaseLayout title="Tableau de Bord - Le Ballon Rouge">
  <div class="min-h-screen bg-[#fef9f0] p-6 md:p-12">
    <div class="max-w-5xl mx-auto">
      
      <!-- Clean Header (No Logout Button) -->
      <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-black text-slate-900">Bienvenue, {displayName} 👋</h1>
        <p class="text-slate-600 mt-2">Votre espace sécurisé est prêt.</p>
      </div>

      <!-- Quick Access Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Card 1: Photos & Activities -->
        <a href="/centres/" class="group bg-white p-6 rounded-2xl shadow-sm border border-black/5 hover:shadow-md hover:border-red-200 transition-all duration-200">
          <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">📸</div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Photos & Activités</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Voir les moments capturés et les activités quotidiennes de vos enfants.</p>
        </a>

        <!-- Card 2: Registration / Info -->
        <a href="/inscription/" class="group bg-white p-6 rounded-2xl shadow-sm border border-black/5 hover:shadow-md hover:border-red-200 transition-all duration-200">
          <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">📋</div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Inscriptions</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Gérer les inscriptions, consulter les formulaires et les disponibilités.</p>
        </a>

        <!-- Card 3: Programs & Events -->
        <a href="/programmes/" class="group bg-white p-6 rounded-2xl shadow-sm border border-black/5 hover:shadow-md hover:border-red-200 transition-all duration-200">
          <div class="w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">📅</div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Programmes & Événements</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Consulter le calendrier, les sorties éducatives et les programmes offerts.</p>
        </a>

        <!-- Card 4: Contact / Support -->
        <a href="/contact/" class="group bg-white p-6 rounded-2xl shadow-sm border border-black/5 hover:shadow-md hover:border-red-200 transition-all duration-200">
          <div class="w-12 h-12 rounded-xl bg-purple-50 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">💬</div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Nous Contacter</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Poser une question à l'équipe ou signaler un absentéisme.</p>
        </a>

        <!-- Card 5: Parent Resources -->
        <a href="/espace-parents/" class="group bg-white p-6 rounded-2xl shadow-sm border border-black/5 hover:shadow-md hover:border-red-200 transition-all duration-200">
          <div class="w-12 h-12 rounded-xl bg-orange-50 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">🏠</div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Espace Parents</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Guides, menus hebdomadaires et ressources pour la maison.</p>
        </a>

        <!-- Card 6: Centers Info -->
        <a href="/centres/" class="group bg-white p-6 rounded-2xl shadow-sm border border-black/5 hover:shadow-md hover:border-red-200 transition-all duration-200">
          <div class="w-12 h-12 rounded-xl bg-teal-50 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">📍</div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Nos Centres</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Informations sur Hamilton et Brantford, horaires et équipes.</p>
        </a>

      </div>
    </div>
  </div>
</BaseLayout>