---
// components/FloatingFeedbackBtn.astro
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = "fr" } = Astro.props;
const t = useTranslations(lang);

const label = lang === "en" ? "Feedback" : "Feedback";
const tooltipText = lang === "en" ? "Send feedback" : "Envoyer un feedback";
---

<a
  href="mailto:leballonrouge@cscmonavenir.ca?subject=Feedback%20Site%20Web&body=Bonjour,%0A%0AVoici%20mes%20suggestions%20pour%20améliorer%20le%20site%20:%0A%0A-%20"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="fixed bottom-[90px] left-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-red-700 text-white shadow-xl shadow-red-900/30 hover:bg-red-800 hover:scale-110 transition-all duration-200 group"
>
  <!-- Message Icon -->
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
  </svg>
  
  <!-- Tooltip on Hover -->
  <span class="absolute left-full ml-3 whitespace-nowrap rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-bold text-white opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
    {tooltipText} →
  </span>
</a>