---
interface Props {
  icon: string;
  tag: string;
  title: string;
  body: string;
  pills: string[];
  bullets: string[];
  href: string;
  gradient: string;
  blob: string;
}

const {
  icon,
  tag,
  title,
  body,
  pills,
  bullets,
  href,
  gradient,
  blob,
} = Astro.props;
---

<!-- REMOVED the 'name' attribute so they act independently -->
<details
  class="event-item group overflow-hidden rounded-[26px] border border-black/10 bg-white shadow-lg shadow-black/5 transition-all"
>
  <!-- Collapsed Header -->
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 transition-colors duration-200 group-open:border-b group-open:border-black/5 group-open:bg-red-50/40 md:px-8 md:py-6">
    <div class="flex items-center gap-4">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-black/10 bg-white shadow-sm">
        <span aria-hidden="true" class="text-xl">{icon}</span>
      </div>
      <div>
        <p class="text-xs font-extrabold uppercase tracking-wider text-red-700">{tag}</p>
        <h3 class="text-lg font-black text-slate-900">{title}</h3>
      </div>
    </div>
    
    <!-- Animated Chevron -->
    <span
      aria-hidden="true"
      class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-black/10 bg-white text-red-700 shadow-sm transition-transform duration-300 group-open:rotate-180"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </span>
  </summary>

  <!-- Expanded Body (Animated) -->
  <!-- ADDED: transition-[grid-template-rows] duration-300 ease-in-out -->
  <div class="event-body overflow-hidden transition-[grid-template-rows] duration-300 ease-in-out">
    <div class={`relative px-6 pb-6 pt-4 md:px-8 md:pb-8 md:pt-6 bg-gradient-to-br ${gradient}`}>
      <!-- Decorative Blob -->
      <div class={`absolute -right-12 -top-12 h-40 w-40 rounded-full ${blob} blur-2xl pointer-events-none`}></div>

      <div class="relative z-10">
        <p class="leading-7 text-slate-600">{body}</p>

        <!-- Pills -->
        <div class="mt-4 flex flex-wrap gap-2 text-xs font-extrabold">
          {pills.map((pill) => (
            <span class="rounded-full border border-black/10 bg-white/80 px-3 py-2 text-slate-700 backdrop-blur-sm">
              {pill}
            </span>
          ))}
        </div>

        <!-- Bullets -->
        <ul class="mt-4 space-y-2 font-semibold text-slate-700">
          {bullets.map((b) => (
            <li class="flex items-start gap-2">
              <span class="mt-2.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-red-600"></span>
              {b}
            </li>
          ))}
        </ul>

        <!-- CTA -->
        <div class="mt-6">
          <a
            href={href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full bg-red-700 px-5 py-2.5 text-sm font-extrabold text-white shadow-lg shadow-red-700/20 hover:bg-red-800 transition-colors"
          >
            📄 Voir le document →
          </a>
        </div>
      </div>
    </div>
  </div>
</details>