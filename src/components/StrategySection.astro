---
interface Strategy {
  letter: string;
  title: string;
  items: string[];
}

interface Props {
  strategies: Strategy[];
}

const { strategies } = Astro.props;
---

<section class="mx-auto max-w-4xl px-4 pb-12">
  <div class="mb-8 text-center md:text-left">
    <div class="inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1 text-xs font-black uppercase tracking-widest text-red-700 ring-1 ring-red-100">
      Notre programme vise aux
    </div>
    <h2 class="mt-3 text-2xl font-black tracking-tight md:text-3xl">Stratégies mises en œuvre</h2>
    <p class="mt-2 max-w-2xl text-slate-600 md:text-lg">
      Cliquez sur un point pour voir les détails de notre approche.
    </p>
  </div>

  <div class="flex flex-col gap-6 md:flex-row md:gap-8">
    
    <!-- Left Side: The "Highlighted Bulletpoints" List -->
    <div class="w-full md:w-1/2 flex flex-col gap-2">
      {strategies.map((s, i) => (
        <button
          class={`strategy-btn group flex items-center gap-3 rounded-xl border px-4 py-3 text-left transition-all duration-200 ${
            i === 0 
              ? 'border-red-200 bg-red-50 shadow-md ring-1 ring-red-100' 
              : 'border-black/10 bg-white hover:border-red-200 hover:bg-red-50/50'
          }`}
          data-index={i}
        >
          <!-- The "Bullet" -->
          <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-black transition-colors ${
             i === 0 ? 'bg-red-700 text-white' : 'bg-red-100 text-red-700 group-hover:bg-red-200'
          }`}>
            {s.letter}
          </span>
          <!-- The Title -->
          <span class={`text-sm font-bold leading-tight transition-colors ${
             i === 0 ? 'text-red-900' : 'text-slate-700 group-hover:text-red-800'
          }`}>
            {s.title}
          </span>
        </button>
      ))}
    </div>

    <!-- Right Side (or Bottom on mobile): The Detail Panel -->
    <div class="w-full md:w-1/2">
      <div class="sticky top-28 rounded-[28px] border border-black/10 bg-white p-6 shadow-xl shadow-black/5 md:p-8">
        {strategies.map((s, i) => (
          <div
            class={`strategy-content transition-all duration-300 ${i === 0 ? 'block opacity-100 translate-y-0' : 'hidden opacity-0 translate-y-2'}`}
            data-content-index={i}
          >
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-black/5">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-red-700 text-lg font-black text-white shadow-lg shadow-red-700/20">
                {s.letter}
              </div>
              <h3 class="text-lg font-black text-slate-900 md:text-xl">{s.title}</h3>
            </div>
            
            <ul class="space-y-4">
              {s.items.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-full bg-red-500"></span>
                  <p class="text-sm font-medium leading-relaxed text-slate-600 md:text-base">{item}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script is:inline>
  const buttons = document.querySelectorAll('.strategy-btn');
  const contents = document.querySelectorAll('.strategy-content');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const index = btn.getAttribute('data-index');

      // 1. Reset all buttons to "idle" style
      buttons.forEach((b) => {
        b.className = 'strategy-btn group flex items-center gap-3 rounded-xl border px-4 py-3 text-left transition-all duration-200 border-black/10 bg-white hover:border-red-200 hover:bg-red-50/50';
        
        const badge = b.querySelector('span:first-child');
        const title = b.querySelector('span:last-child');
        if(badge) badge.className = 'flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-black transition-colors bg-red-100 text-red-700 group-hover:bg-red-200';
        if(title) title.className = 'text-sm font-bold leading-tight transition-colors text-slate-700 group-hover:text-red-800';
      });

      // 2. Set clicked button to "active/highlighted" style
      btn.className = 'strategy-btn group flex items-center gap-3 rounded-xl border px-4 py-3 text-left transition-all duration-200 border-red-200 bg-red-50 shadow-md ring-1 ring-red-100';
      const activeBadge = btn.querySelector('span:first-child');
      const activeTitle = btn.querySelector('span:last-child');
      if(activeBadge) activeBadge.className = 'flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-black transition-colors bg-red-700 text-white';
      if(activeTitle) activeTitle.className = 'text-sm font-bold leading-tight transition-colors text-red-900';

      // 3. Hide all contents, show selected (FIXED OPACITY BUG)
      contents.forEach((c) => {
        c.classList.add('hidden', 'opacity-0', 'translate-y-2');
        c.classList.remove('block', 'opacity-100', 'translate-y-0');
      });
      
      const activeContent = document.querySelector(`[data-content-index="${index}"]`);
      if (activeContent) {
        activeContent.classList.remove('hidden', 'opacity-0', 'translate-y-2');
        activeContent.classList.add('block', 'opacity-100', 'translate-y-0');
      }
    });
  });
</script>