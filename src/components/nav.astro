---
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n";

interface Props { lang?: Lang; }

const { lang = "fr" } = Astro.props;
const t = useTranslations(lang).nav;
const base = lang === "en" ? "/en" : "";

// ✅ READ AUTH STATE FROM SERVER-SIDE LOCALS
const { user } = Astro.locals;
const isAuthenticated = !!user;

const centreLinks = {
  hamilton: `${base}/centres/hamilton/`,
  brantford: `${base}/centres/brantford/`,
};
---

<header class="border-b border-black/10 bg-white/95 backdrop-blur-xl">
  <div class="mx-auto max-w-screen-2xl px-3 py-3 md:px-4 md:py-4">
    <div class="flex items-center justify-between">

      <!-- Logo -->
      <a href={`${base}/`} class="flex min-h-0 items-center gap-2 md:gap-3 shrink-0">
        <img
          src="/assets/images/LBR_No_Name.png"
          alt="Le Ballon Rouge"
          class="h-9 w-9 rounded-full object-contain bg-white shadow-lg md:h-11 md:w-11"
          loading="eager"
          decoding="async"
          width="44"
          height="44"
        />
        <div class="hidden sm:block">
          <p class="text-sm font-black text-slate-900 md:text-base">Le Ballon Rouge</p>
          <p class="text-[10px] font-semibold text-slate-600 md:text-xs">{t.tagline}</p>
        </div>
      </a>

      <!-- Desktop nav (Centered) -->
      <nav class="hidden xl:flex items-center justify-center flex-1 px-4" aria-label={t.ariaNav}>
        <div class="flex items-center gap-1">

          <div class="nav-group">
            <a href={`${base}/qui-sommes-nous/`} class="nav-trigger">
              {t.about} <span class="arrow" aria-hidden="true"></span>
            </a>
            <div class="nav-dropdown">
              <a href={`${base}/qui-sommes-nous/#vmv`} class="dropdown-item">{t.aboutDropdown.vmv}</a>
              <a href={`${base}/qui-sommes-nous/#partenariats`} class="dropdown-item">{t.aboutDropdown.partnerships}</a>
              <a href={`${base}/qui-sommes-nous/#temoignages`} class="dropdown-item">{t.aboutDropdown.testimonials}</a>
            </div>
          </div>

          <div class="nav-group">
            <a href={`${base}/inscription/`} class="nav-trigger">
              {t.inscription} <span class="arrow" aria-hidden="true"></span>
            </a>
            <div class="nav-dropdown">
              <a href={`${base}/inscription/hamilton/`} class="dropdown-item">Le Ballon Rouge — Hamilton</a>
              <a href={`${base}/inscription/brantford/`} class="dropdown-item">Le Ballon Rouge — Brantford</a>
            </div>
          </div>

          <div class="nav-group">
            <a href={`${base}/espace-parents/`} class="nav-trigger">
              {t.parents} <span class="arrow" aria-hidden="true"></span>
            </a>
            <div class="nav-dropdown">
              <a href={`${base}/espace-parents/#guide`} class="dropdown-item">{t.parentsDropdown.guide}</a>
              <a href={`${base}/espace-parents/#frais`} class="dropdown-item">{t.parentsDropdown.fees}</a>
              <a href={`${base}/espace-parents/#menu`} class="dropdown-item">{t.parentsDropdown.menu}</a>
              <a href={`${base}/espace-parents/#ressources`} class="dropdown-item">{t.parentsDropdown.resources}</a>
            </div>
          </div>

          <div class="nav-group">
            <a href={`${base}/programmes/`} class="nav-trigger">
              {t.programmes} <span class="arrow" aria-hidden="true"></span>
            </a>
            <div class="nav-dropdown">
              <a href={`${base}/programmes/#enonce`} class="dropdown-item">{t.programmesDropdown.statement}</a>
              <a href={`${base}/programmes/#qualite`} class="dropdown-item">{t.programmesDropdown.quality}</a>
              <a href={`${base}/programmes/#evenements`} class="dropdown-item">{t.programmesDropdown.events}</a>
            </div>
          </div>

          <div class="nav-group">
            <a href={`${base}/personnel/`} class="nav-trigger">
              {t.personnel} <span class="arrow" aria-hidden="true">▾</span>
            </a>
            <div class="nav-dropdown">
              <a href={`${base}/personnel/#reconnaissances`} class="dropdown-item">{t.personnelDropdown.recognition}</a>
              <a href={`${base}/personnel/#emplois`} class="dropdown-item">{t.personnelDropdown.jobs}</a>
            </div>
          </div>

          <div class="nav-group">
            <a href={`${base}/gouvernance/`} class="nav-trigger">{t.gouvernance}</a>
          </div>

          <div class="nav-group">
            <a href={`${base}/contact/`} class="nav-trigger">{t.contact}</a>
          </div>

          <div class="nav-group">
            <a href={`${base}/centres/`} class="nav-trigger">
              {t.centres} <span class="arrow" aria-hidden="true"></span>
            </a>
            <div class="nav-dropdown">
              <a href={centreLinks.hamilton} class="dropdown-item">Le Ballon Rouge — Hamilton</a>
              <a href={centreLinks.brantford} class="dropdown-item">Le Ballon Rouge — Brantford</a>
            </div>
          </div>

        </div>
      </nav>

      <!-- Right side actions (Far Right) -->
      <div class="flex items-center gap-2 md:gap-3 shrink-0">
        
        <!-- Language Switcher -->
        <div class="nav-group hidden sm:block">
          <button
            type="button"
            class="nav-trigger lang-trigger cursor-pointer"
            id="langToggle"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label={t.ariaLang}
          >
            <span class="lang-current font-bold" data-lang={lang}>
              {t.langLabel}
            </span>
            <span class="arrow" aria-hidden="true"></span>
          </button>
          <div class="nav-dropdown lang-dropdown">
            <a id="lang-opt-fr" href="/" class="dropdown-item lang-option" data-lang="fr">
              Français
            </a>
            <a id="lang-opt-en" href="/en/" class="dropdown-item lang-option" data-lang="en">
              English
            </a>
          </div>
        </div>

        <!-- Inscription CTA -->
        <a
          href={`${base}/inscription/`}
          class="hidden lg:inline-flex items-center gap-2 rounded-full bg-red-700 px-4 py-2.5 text-sm font-extrabold text-white hover:bg-red-800 shadow-lg shadow-red-700/25 transition-all duration-150"
        >
          {t.cta} <span aria-hidden="true">→</span>
        </a>

        <!-- ✅ AUTH-AWARE PROFILE DROPDOWN / LOGIN BUTTON -->
        {isAuthenticated ? (
          <div class="relative group hidden sm:block">
            <!-- Trigger Button -->
            <button class="flex items-center gap-2 rounded-full bg-slate-900 pl-1 pr-3 py-1 text-sm font-bold text-white hover:bg-slate-800 transition-all duration-150 cursor-pointer">
              <div class="w-8 h-8 rounded-full bg-red-600 flex items-center justify-center text-xs font-black">
                {user.email?.charAt(0).toUpperCase() || 'P'}
              </div>
              <span class="max-w-[100px] truncate">{user.email?.split('@')[0]}</span>
              <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>

            <!-- Dropdown Menu (Streamlined: No Profile Link) -->
            <div class="absolute right-0 top-full mt-2 w-48 bg-white rounded-xl shadow-xl border border-black/5 py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right z-50">
              <a href="/accounts/dashboard" class="block px-4 py-3 text-sm font-bold text-slate-700 hover:bg-red-50 hover:text-red-700 transition-colors">
                 Tableau de bord
              </a>
              <div class="h-px bg-black/5 my-1"></div>
              <a href="/api/auth/signout" class="block px-4 py-3 text-sm font-bold text-red-600 hover:bg-red-50 transition-colors">
                 Se déconnecter
              </a>
            </div>
          </div>
        ) : (
          <a 
            id="global-login-btn"
            href={`${base}/accounts/login`}
            class="hidden sm:inline-flex items-center gap-2 rounded-full border-2 border-red-700 bg-white px-4 py-2 text-sm font-extrabold text-red-700 hover:bg-red-50 transition-all duration-150"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Se Connecter!
          </a>
        )}

        <!-- Mobile Menu Toggle -->
        <button
          id="menuBtn"
          type="button"
          class="mobile-menu-btn flex cursor-pointer items-center justify-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-extrabold text-slate-700 hover:bg-slate-50 active:bg-slate-100 select-none transition-colors duration-150"
          aria-expanded="false"
          aria-controls="mobileMenu"
          aria-label="Menu"
        >
          <svg id="menuIconOpen" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menuIconClose" class="h-4 w-4 icon-hidden" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span id="menuLabel">{t.menu}</span> 
        </button>

      </div>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobileMenu" class="mobile-menu-panel" aria-hidden="true">
    <div class="border-t border-slate-100 bg-white/98 backdrop-blur-xl shadow-2xl shadow-black/10">
      <div class="mx-auto max-w-7xl px-4 pb-6 pt-4">

        <p class="mb-3 text-[10px] font-black uppercase tracking-[0.15em] text-slate-400">Navigation</p>

        <nav aria-label="Mobile navigation" class="grid grid-cols-2 gap-2">
          <a href={`${base}/qui-sommes-nous/`} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             {t.about}
          </a>
          <a href={`${base}/inscription/`} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             {t.inscription}
          </a>
          <a href={`${base}/espace-parents/`} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             {t.parents}
          </a>
          <a href={`${base}/centres/`} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             {t.centres}
          </a>
          <a href={centreLinks.hamilton} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             Le Ballon Rouge — Hamilton
          </a>
          <a href={centreLinks.brantford} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             Le Ballon Rouge — Brantford
          </a>
          <a href={`${base}/programmes/`} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             {t.programmes}
          </a>
          <a href={`${base}/personnel/`} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             {t.personnel}
          </a>
          <a href={`${base}/gouvernance/`} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             {t.gouvernance}
          </a>
          <a href={`${base}/contact/`} class="mobile-nav-link group flex items-center gap-2 rounded-2xl border border-transparent px-4 py-3.5 text-sm font-bold text-slate-700 transition-all duration-150 hover:border-red-100 hover:bg-red-50 hover:text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-300 transition-colors duration-150 group-hover:bg-red-400"></span>
             {t.contact}
          </a>
        </nav>

        <!-- Mobile CTA Buttons -->
        <div class="mt-6 flex flex-col gap-3">
          <a
            href={`${base}/inscription/`}
            class="flex items-center justify-center gap-2 rounded-full bg-red-700 px-4 py-3 text-sm font-extrabold text-white hover:bg-red-800 shadow-lg shadow-red-700/25 transition-all duration-150"
          >
            {t.cta} <span aria-hidden="true">→</span>
          </a>
          
          {isAuthenticated ? (
            <>
              <a
                href="/accounts/dashboard"
                class="flex items-center justify-center gap-2 rounded-full bg-slate-900 px-4 py-3 text-sm font-extrabold text-white hover:bg-slate-800 transition-all duration-150"
              >
                 Mon Espace →
              </a>
              <a
                href="/api/auth/signout"
                class="flex items-center justify-center gap-2 rounded-full border-2 border-red-200 bg-red-50 px-4 py-3 text-sm font-extrabold text-red-700 hover:bg-red-100 transition-all duration-150"
              >
                 Se déconnecter
              </a>
            </>
          ) : (
            <a
              href={`${base}/accounts/login`}
              class="flex items-center justify-center gap-2 rounded-full border-2 border-red-700 bg-white px-4 py-3 text-sm font-extrabold text-red-700 hover:bg-red-50 transition-all duration-150"
            >
               Espace Parents →
            </a>
          )}
        </div>

      </div>
    </div>
  </div>

  <!-- Nav inline script for mobile menu toggle -->
  <script is:inline>
    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const menuIconOpen = document.getElementById('menuIconOpen');
    const menuIconClose = document.getElementById('menuIconClose');
    const menuLabel = document.getElementById('menuLabel');

    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', () => {
        const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!isOpen));
        mobileMenu.setAttribute('aria-hidden', String(isOpen));
        
        if (!isOpen) {
          menuIconOpen.classList.add('icon-hidden');
          menuIconClose.classList.remove('icon-hidden');
          mobileMenu.classList.add('open');
        } else {
          menuIconOpen.classList.remove('icon-hidden');
          menuIconClose.classList.add('icon-hidden');
          mobileMenu.classList.remove('open');
        }
      });
    }
  </script>
</header>