---
// src/components/FloatingApplyBtn.astro
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n";

interface Props { lang?: Lang; }
const { lang = "fr" } = Astro.props;
const t = useTranslations(lang);
const base = lang === "en" ? "/en" : "";
const applyLink = `${base}/personnel/#emplois`;
const label = lang === "en" ? "Apply" : "Postuler";
---

<a
  href={applyLink}
  aria-label={label}
  class="fixed bottom-6 left-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-red-700 text-white shadow-xl shadow-red-900/30 hover:bg-red-800 hover:scale-110 transition-all duration-200 group"
>
  <!-- Briefcase Icon -->
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
  </svg>
  
  <!-- Tooltip on Hover -->
  <span class="absolute left-full ml-3 whitespace-nowrap rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-bold text-white opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
    {label} →
  </span>
</a>