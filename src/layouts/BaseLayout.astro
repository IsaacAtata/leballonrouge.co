---
import "../styles/global.css";
import Nav from "../components/nav.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import Toast from "../components/Toast.astro";
import { useTranslations } from "../i18n";
import type { Lang } from "../i18n";

const {
  title = "TODO: Page title",
  lang = "fr",
  description = "TODO: Page description",
} = Astro.props as { title?: string; lang?: Lang; description?: string };

const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title} | Le Ballon Rouge</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://leballonrouge.ca${Astro.url.pathname}`} />

    <!-- Open Graph -->
    <meta property="og:type"         content="website" />
    <meta property="og:site_name"    content="Le Ballon Rouge" />
    <meta property="og:title"        content={`${title} | Le Ballon Rouge`} />
    <meta property="og:description"  content={description} />
    <meta property="og:url"          content={`https://leballonrouge.ca${Astro.url.pathname}`} />
    <meta property="og:image"        content="https://leballonrouge.ca/og-image.jpg" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale"       content={lang === "en" ? "en_CA" : "fr_CA"} />

    <!-- Twitter / X card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={`${title} | Le Ballon Rouge`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content="https://leballonrouge.ca/og-image.jpg" />

    <!-- Iconify -->
    <script src="https://code.iconify.design/3/3.1.1/iconify.min.js" defer></script>
    
    <!-- Global Type Declaration for window.supabase -->
    <script is:inline>
      /** @type {any} */
      window.supabase = null;
    </script>
    
    <!-- Supabase Client -->
    <script type="module" src="/assets/scripts/supabase-client.js" defer></script>
  </head>

  <body class="min-h-screen text-slate-800 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only fixed left-4 top-4 z-50 rounded-xl bg-white px-3 py-2 shadow-lg focus:outline-none focus:ring-2 focus:ring-red-500"
    >
      {lang === "en" ? t.layout.skipLinkEn : t.layout.skipLinkFr}
    </a>

    <Nav lang={lang} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />
    <BackToTop />
    <Toast />

    <!-- Smart sticky nav script (Existing) -->
    <script is:inline>
      (function () {
        var header = document.querySelector('header');
        if (!header) return;

        function setBodyPadding() {
          var h = header.offsetHeight;
          if (h > 0) document.body.style.paddingTop = h + 'px';
        }

        requestAnimationFrame(setBodyPadding);
        window.addEventListener('load',   setBodyPadding, { passive: true });
        window.addEventListener('resize', setBodyPadding, { passive: true });

        var lastY     = window.scrollY;
        var ticking   = false;
        var THRESHOLD = 80;

        function update() {
          var currentY = window.scrollY;
          header.classList.toggle('is-scrolled', currentY > 10);
          if (currentY > THRESHOLD) {
            header.classList.toggle('nav-hidden', currentY > lastY);
          } else {
            header.classList.remove('nav-hidden');
          }
          lastY   = currentY;
          ticking = false;
        }

        window.addEventListener('scroll', function () {
          if (!ticking) { requestAnimationFrame(update); ticking = true; }
        }, { passive: true });

        document.addEventListener('astro:after-swap', function () {
          setBodyPadding();
          lastY = window.scrollY;
          header.classList.remove('nav-hidden', 'is-scrolled');
        });
      })();
    </script>

    <!-- PRIVACY GUARD: Blurs protected content when not logged in -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', async function() {
        // Wait for Supabase client to load
        if (!window.supabase) return;
        
        try {
          const { data: { session } } = await window.supabase.auth.getSession();
          const isLoggedIn = !!session;
          
          // Find all protected elements
          const protectedItems = document.querySelectorAll('.protected-media, .protected-content');
          
          protectedItems.forEach(el => {
            if (isLoggedIn) {
              el.classList.remove('blurred', 'locked-overlay');
              el.removeAttribute('aria-hidden');
              // Remove lock overlay if exists
              const overlay = el.querySelector('.lock-overlay');
              if (overlay) overlay.remove();
            } else {
              el.classList.add('blurred');
              el.setAttribute('aria-hidden', 'true');
              
              // Add lock overlay if not present
              if (!el.querySelector('.lock-overlay')) {
                const overlay = document.createElement('div');
                overlay.className = 'lock-overlay absolute inset-0 flex items-center justify-center bg-white/60 backdrop-blur-sm z-10 rounded-[28px] cursor-pointer';
                overlay.innerHTML = `
                  <div class="text-center p-4 pointer-events-none">
                    <span class="text-3xl mb-2 block">🔒</span>
                    <p class="text-sm font-bold text-slate-700">Contenu réservé aux familles</p>
                    <a href="/espace-parents/login" class="mt-2 inline-block text-xs font-extrabold text-red-700 hover:underline pointer-events-auto">Se connecter →</a>
                  </div>
                `;
                el.style.position = 'relative';
                el.appendChild(overlay);
              }
            }
          });

          // Update Nav Button if exists
          const loginBtn = document.getElementById('global-login-btn');
          if (loginBtn) {
            loginBtn.textContent = isLoggedIn ? 'Mon Compte' : 'Espace Parents';
            loginBtn.href = isLoggedIn ? '/espace-parents/dashboard' : '/espace-parents/login';
          }
        } catch (err) {
          console.error('Privacy Guard Error:', err);
        }
      });
    </script>

    <!-- Global Styles for Protected Content -->
    <style is:global>
      .protected-media, .protected-content {
        transition: filter 0.3s ease, opacity 0.3s ease;
        position: relative;
      }
      
      .blurred {
        filter: blur(12px) grayscale(80%);
        pointer-events: none;
        user-select: none;
      }
      
      .blurred img, .blurred video {
        pointer-events: none;
      }
      
      .lock-overlay {
        transition: opacity 0.3s ease;
      }
    </style>

    <!-- legacy.js -->
    <script is:inline src="/assets/scripts/legacy.js"></script>
  </body>
</html>